<?xml version="1.0" encoding="UTF-8"?>
<!-- 后台管理 Java 后端：Spring Boot 3.5 + JDK 17 + Sa-Token + MyBatis-Plus + PostgreSQL 16 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- 继承 Spring Boot 官方父工程，统一管理依赖版本 -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.5</version>
    <relativePath/>
  </parent>

  <groupId>com.janus</groupId>
  <artifactId>janus-backend</artifactId>
  <version>1.2.2</version>
  <name>janus</name>
  <description>后台管理后端服务（Java 实现）</description>

  <properties>
    <java.version>17</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- 第三方依赖版本集中管理 -->
    <sa-token.version>1.45.0</sa-token.version>
    <mybatis-plus.version>3.5.17</mybatis-plus.version>
    <!-- knife4j（Boot 3 / jakarta 官方版，内置 springdoc-openapi 2.x） -->
    <knife4j.version>4.5.0</knife4j.version>
    <!-- springdoc-openapi：与 Spring Boot 3.5 对齐（覆盖 knife4j 传递引入的旧版） -->
    <springdoc.version>2.8.13</springdoc.version>
  </properties>

  <dependencies>
    <!-- Boot 3 提供 spring-boot-starter-web（Boot 4 起才更名为 webmvc） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- 参数校验 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- AOP（操作日志切面用） -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-aop</artifactId>
    </dependency>
    <dependency>
      <groupId>org.aspectj</groupId>
      <artifactId>aspectjweaver</artifactId>
    </dependency>

    <!-- 邮件服务（邮箱验证码发送，配置见 application.yml spring.mail） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-mail</artifactId>
    </dependency>

    <!-- MyBatis-Plus（Boot 3 专用 starter） -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
      <version>${mybatis-plus.version}</version>
    </dependency>

    <!-- 分页插件（3.5.9+ 拆分为可选依赖） -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-jsqlparser</artifactId>
      <version>${mybatis-plus.version}</version>
    </dependency>

    <!-- PostgreSQL 驱动 -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Flyway 数据库版本控制（版本由 Boot 父工程管理；Flyway 10+ 拆分数据库支持，PG 需独立模块） -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <!-- Sa-Token 认证（Boot 3 专用 starter） -->
    <dependency>
      <groupId>cn.dev33</groupId>
      <artifactId>sa-token-spring-boot3-starter</artifactId>
      <version>${sa-token.version}</version>
    </dependency>

    <!-- Sa-Token SSO 模块：对外开放单点登录授权中心 -->
    <dependency>
      <groupId>cn.dev33</groupId>
      <artifactId>sa-token-sso</artifactId>
      <version>${sa-token.version}</version>
    </dependency>

    <!-- Sa-Token Redis 存储适配器（共享 Redis 模式二统一 Token） -->
    <dependency>
      <groupId>cn.dev33</groupId>
      <artifactId>sa-token-redis-template</artifactId>
      <version>${sa-token.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-pool2</artifactId>
    </dependency>

    <!-- 仅用其 BCrypt 实现，不引入 Security 过滤链 -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-crypto</artifactId>
    </dependency>

    <!-- 系统监控（CPU/内存/磁盘信息） -->
    <dependency>
      <groupId>com.github.oshi</groupId>
      <artifactId>oshi-core</artifactId>
      <version>6.8.2</version>
    </dependency>

    <!-- WebSocket 实时通知 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-websocket</artifactId>
    </dependency>

    <!-- API 文档：knife4j（Boot 3 版，页面入口 /doc.html）+ springdoc-openapi 2 -->
    <dependency>
      <groupId>com.github.xiaoymin</groupId>
      <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
      <version>${knife4j.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>

    <!-- Apache POI：Excel 导出 -->
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-ooxml</artifactId>
      <version>5.3.0</version>
    </dependency>

    <!-- Lombok：仅编译期 -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- 显式声明 Lombok 注解处理器，兼容 JDK 17+ -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${lombok.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>

      <!-- 单体部署：在 maven 内自动构建前端（web-antd，pnpm workspace），无需宿主机安装 node/pnpm。
           顺序：prepare-package 阶段先 frontend-maven-plugin 构建出 dist，再由 antrun 拷入 target/classes/static，
           最后 spring-boot-maven-plugin 的 repackage 把含静态资源的 classes 打成 fat jar。 -->
      <plugin>
        <groupId>com.github.eirslett</groupId>
        <artifactId>frontend-maven-plugin</artifactId>
        <version>1.15.4</version>
        <configuration>
          <workingDirectory>${basedir}/../janus-frontend</workingDirectory>
          <installDirectory>${basedir}/../janus-frontend</installDirectory>
          <npmRegistryURL>https://registry.npmmirror.com/</npmRegistryURL>
          <nodeDownloadRoot>https://registry.npmmirror.com/-/binary/node/</nodeDownloadRoot>
          <environmentVariables>
            <NODE_OPTIONS>--max-old-space-size=8192</NODE_OPTIONS>
          </environmentVariables>
        </configuration>
        <executions>
          <execution>
            <id>install-node-and-pnpm</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>install-node-and-pnpm</goal>
            </goals>
            <configuration>
              <nodeVersion>v22.21.1</nodeVersion>
              <pnpmVersion>11.23.0</pnpmVersion>
            </configuration>
          </execution>
          <execution>
            <id>pnpm-install</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>pnpm</goal>
            </goals>
            <configuration>
              <arguments>install</arguments>
            </configuration>
          </execution>
          <execution>
            <id>pnpm-build</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>pnpm</goal>
            </goals>
            <configuration>
              <!-- 直接 exec vite，避免 web-antd 的 build 脚本里再嵌套一次 pnpm（插件生成的 pnpm 软链在 shell 下无 +x） -->
              <arguments>--filter @vben/web-antd exec vite build --mode production</arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- 拷贝前端构建产物到 target/classes/static，由 Spring Boot 静态资源处理器在根路径 "/" 直接提供 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.2.0</version>
        <executions>
          <execution>
            <id>copy-frontend-to-static</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <delete dir="${project.build.outputDirectory}/static"/>
                <copy todir="${project.build.outputDirectory}/static" overwrite="true">
                  <fileset dir="${basedir}/../janus-frontend/apps/web-antd/dist">
                    <include name="**/*"/>
                  </fileset>
                </copy>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
